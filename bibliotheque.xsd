<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    
    <xs:simpleType name="isbnType">
        <xs:restriction base="xs:string">
            <xs:pattern value="ISBN-[0-9]{2}-[0-9]{4}"></xs:pattern>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="titreType">
        <xs:restriction base="xs:string">
            <xs:minLength value="2"></xs:minLength>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="genreType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Roman"></xs:enumeration>
            <xs:enumeration value="Poesie"></xs:enumeration>
            <xs:enumeration value="Theatre"></xs:enumeration>
            <xs:enumeration value="Biographie"></xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="bibliotheque">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="titre" type="titreType"></xs:element>
                <xs:element name="annee_publication" type="xs:gYear"></xs:element>
                <xs:element name="genre" type="genreType"></xs:element>
            </xs:sequence>

            <xs:attribute name="isbn" type="isbnType" use="required"></xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>